# Kopiér denne fil til .env og udfyld værdierne

# Database — SQLite til lokal udvikling, PostgreSQL til produktion
DATABASE_URL=sqlite:///./sommerhus.db

# Admin-adgang
ADMIN_PASSWORD=skift-mig
SECRET_KEY=generér-en-lang-tilfældig-streng-her

# Stripe (udfyldes i Trin 9)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Resend mail (udfyldes i Trin 10)
RESEND_API_KEY=
ADMIN_EMAIL=din@email.dk
